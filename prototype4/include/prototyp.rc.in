#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @prototyp4_VERSION_MAJOR@,@prototyp4_VERSION_MINOR@,@prototyp4_VERSION_PATCH@,@prototyp4_VERSION_TWEAK@
 PRODUCTVERSION @prototyp4_VERSION_MAJOR@,@prototyp4_VERSION_MINOR@,@prototyp4_VERSION_PATCH@,@prototyp4_VERSION_TWEAK@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FFI DLL"
            VALUE "FileVersion", "@prototyp4_VERSION_MAJOR@, @prototyp4_VERSION_MINOR@, @prototyp4_VERSION_PATCH@, @prototyp4_VERSION_TWEAK@"
            VALUE "InternalName", "FFI DLL"
            VALUE "LegalCopyright", "(c) Daniel Giritzer"
            VALUE "OriginalFilename", "prototyp4.dll"
            VALUE "ProductName", "FFI DLL"
            VALUE "ProductVersion", "@prototyp4_VERSION_MAJOR@, @prototyp4_VERSION_MINOR@, @prototyp4_VERSION_PATCH@, @prototyp4_VERSION_TWEAK@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END