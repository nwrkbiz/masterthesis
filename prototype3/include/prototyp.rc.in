#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @prototyp3_VERSION_MAJOR@,@prototyp3_VERSION_MINOR@,@prototyp3_VERSION_PATCH@,@prototyp3_VERSION_TWEAK@
 PRODUCTVERSION @prototyp3_VERSION_MAJOR@,@prototyp3_VERSION_MINOR@,@prototyp3_VERSION_PATCH@,@prototyp3_VERSION_TWEAK@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SCADA V8"
            VALUE "FileVersion", "@prototyp3_VERSION_MAJOR@, @prototyp3_VERSION_MINOR@, @prototyp3_VERSION_PATCH@, @prototyp3_VERSION_TWEAK@"
            VALUE "InternalName", "SCADA V8"
            VALUE "LegalCopyright", "(c) Daniel Giritzer"
            VALUE "OriginalFilename", "prototyp3.exe"
            VALUE "ProductName", "SCADA V8"
            VALUE "ProductVersion", "@prototyp3_VERSION_MAJOR@, @prototyp3_VERSION_MINOR@, @prototyp3_VERSION_PATCH@, @prototyp3_VERSION_TWEAK@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END